PORT=3001
NODE_ENV=development
# Development also accepts localhost + RFC1918 LAN origins for mobile testing.
# Development accepts localhost + RFC1918 LAN origins for mobile testing.
# On Render production use: CORS_ORIGIN=https://galaga-fe.vercel.app
CORS_ORIGIN=http://localhost:5173
ADMIN_KEY=change-me-before-production
ANTI_CHEAT_MODE=enforce
RATE_LIMIT_PER_MINUTE=240
MAX_BODY_BYTES=131072
TELEMETRY_MAX_EVENTS=20000
STORE_PATH=./data/store.json

# Patch 4 sandbox RTP only (disabled until verified)
GAME_PROVIDER_RTP_ENABLED=false
GAME_PROVIDER_RTP_API_URL=https://g-provider-api-free.onrender.com
# GAME_PROVIDER_RTP_ADAPTER_KEY=   # separate read-only key, server-side only
GAME_PROVIDER_RTP_PROBE_ENABLED=false
