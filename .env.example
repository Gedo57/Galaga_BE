PORT=3001
NODE_ENV=development
# Development also accepts localhost + RFC1918 LAN origins for mobile testing.
# Production stays strict and should set the exact deployed FE origin(s).
CORS_ORIGIN=http://localhost:5173
ADMIN_KEY=change-me-before-production
ANTI_CHEAT_MODE=enforce
RATE_LIMIT_PER_MINUTE=240
MAX_BODY_BYTES=131072
TELEMETRY_MAX_EVENTS=20000
STORE_PATH=./data/store.json
