# SideSix (optional)
SIDESIX_ENABLED=true
SIDESIX_BASE_URL=https://sidesix.xyz
SIDESIX_SHARED_SECRET=<shared secret>
SIDESIX_PACK_ID=<galaga pack id>
SIDESIX_CURRENCY=MYR
SIDESIX_HMAC_SKEW_SECONDS=300
SIDESIX_TIMEOUT_MS=8000

# Your Platform (optional, can run together with SideSix)
PLATFORM_ENABLED=true
PLATFORM_BASE_URL=https://gamingplatform-be.onrender.com
PLATFORM_API_PREFIX=/api/v1
PLATFORM_GAME_KEY=gsk_<galaga game service key>
PLATFORM_TIMEOUT_MS=8000
